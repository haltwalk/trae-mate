{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "TraeMate",
  "version": "1.1.0",
  "identifier": "com.traecheck.app",
  "build": {
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TraeMate - 签到与多开账号管理",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0b0d1a"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
